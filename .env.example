# ── Checkly CLI authentication ────────────────────────────────────────────────
# Used by every `npx checkly …` command (test:cloud, deploy, destroy) and by
# ./demo.sh's --cloud verbs. The checkly CLI loads this file from the project
# root automatically; values already exported in your shell take precedence.
# API key:    https://app.checklyhq.com/settings/user/api-keys
# Account ID: Checkly UI → Account settings → General
# Alternative: run `npx checkly login` once and leave these two unset.
CHECKLY_API_KEY=cu_xxxxxxxxxxxxxxxxxxxxxxxx
CHECKLY_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# ── Suite target (all optional — defaults exercise the bundled mock) ──────────
# Set GW_TARGET_HOST to skip the mock gateway and dial a real one.
#GW_TARGET_HOST=
#GW_TARGET_PORT=4443

# Login credentials. For a real gateway, store these as Checkly secrets and
# reference them from the construct — never commit real values here.
#GW_USER=demo
#GW_PASS=demo-password

# Peer-certificate CN asserted by login-success; also used as SNI servername.
#GW_EXPECT_CERT_CN=launcher.example.internal
# Internal CA chain (PEM). Unset ⇒ demo mode (self-signed mock cert,
# verification off). Set ⇒ strict TLS verification with the same client.
#GW_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Packet blast thresholds (send 50, require at least 49 back) ───────────────
#GW_PACKET_COUNT=50
#GW_MIN_RESPONSES=49
#GW_MAX_BLAST_MS=5000

# Mock-only simulated packet loss (what ./demo.sh break sets):
#GW_DROP_RATE=0

# Set to 1 to skip the tcpbin.com external-egress spec:
#GW_SKIP_EXTERNAL=

# ── SSL monitor target ────────────────────────────────────────────────────────
# Endpoint watched by __checks__/ssl-cert.check.ts. Unlike the GW_* vars above,
# this one is read by the CLI at DEPLOY time — it configures the monitor, so
# changing it requires a redeploy. Defaults to a public host so the monitor
# deploys green out of the box; point it at your own endpoint.
#SSL_TARGET_HOST=www.checklyhq.com

# ── Scope notes ───────────────────────────────────────────────────────────────
# - ./demo.sh sources this file, so GW_* values here affect LOCAL runs.
# - Cloud runs do NOT see local GW_* values: pass per-session vars with
#   `npx checkly test -e GW_DROP_RATE=0.2`, or set construct/account env vars.
# - CHECKLY_* values are used by the CLI only; they are never sent into check runs.
