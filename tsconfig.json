{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "checkly.config.ts",
    "__checks__/**/*.ts",
    "launcher/**/*.ts",
    "launcher/**/*.d.mts"
  ]
}
